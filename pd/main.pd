#N canvas 60 60 980 720 10;
#X text 20 14 UNO Q  +  MODULINO  ACID SYNTH;
#X text 20 30 Turn DSP on \, press play. Mouse: click the step grids + sliders. Hardware: knob = tempo / play \, buttons = mute snare / hat / synth \, distance = transpose \, tilt X = cutoff \, tilt Y = resonance \, shake = fill. Joystick click randomises the bass pattern.;
#X obj 20 60 cnv 1 150 60 empty empty empty 8 8 0 12 #e9e4d8 #303030 0;
#X obj 30 82 tgl 28 0 empty empty empty 0 -6 0 8 #e8643c #ffffff #303030 0 1;
#X text 66 90 AUDIO ON;
#X obj 30 120 sel 0;
#X msg 30 144 \; pd dsp 1;
#X msg 120 144 \; pd dsp 0;
#X obj 20 160 transport;
#X obj 20 270 drum;
#X obj 20 410 synth;
#X obj 640 60 udp_io;
#X obj 640 210 cnv 1 320 110 empty empty empty 8 8 0 12 #e9e4d8 #303030 0;
#X text 650 216 MASTER;
#X text 650 242 volume;
#X obj 650 252 hsl 200 18 0 1 0 1 master_vol master_vol_set empty -2 -8 0 10 #f4f1ea #1c1c1c #303030 0.7 1;
#X obj 640 340 fx;
#N canvas 120 120 560 380 master 0;
#X obj 30 24 loadbang;
#X msg 30 48 \; master_vol 0.7 \; master_vol_set 0.7;
#X msg 30 72 \; master_filter 0.5;
#X obj 30 120 catch~ mix;
#X obj 200 120 r master_vol;
#X obj 30 144 *~;
#X obj 30 168 hip~ 20;
#X obj 30 192 lop~ 18000;
#X obj 30 216 clip~ -1 1;
#X obj 30 240 dac~;
#X obj 250 120 r master_filter;
#X obj 250 144 pack f 30;
#X obj 250 168 line;
#X obj 250 192 expr 200*pow(90\, $f1*2);
#X obj 250 216 clip 200 18000;
#X obj 390 192 expr 20*pow(250\, ($f1-0.5)*2);
#X obj 390 216 clip 20 6000;
